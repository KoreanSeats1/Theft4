<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>Theft4</string>
    <key>CFBundleIdentifier</key><string>${THEFT4_BUNDLE_IDENTIFIER}</string>
    <key>CFBundleName</key><string>${THEFT4_DISPLAY_NAME}</string>
    <key>CFBundleDisplayName</key><string>${THEFT4_DISPLAY_NAME}</string>
    <key>Theft4LabBuild</key>${THEFT4_LAB_PLIST_VALUE}
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.2.0</string>
    <key>Theft4ReleaseName</key><string>0.2.0b</string>
    <key>CFBundleVersion</key><string>119</string>
    <!-- Declares App Store export-compliance status for standard/exempt crypto only. -->
    <key>ITSAppUsesNonExemptEncryption</key><false/>
    <key>LSApplicationCategoryType</key><string>public.app-category.games</string>
    <!-- Let the system reduce competing background work during gameplay. -->
    <key>LSSupportsGameMode</key><true/>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>UIFileSharingEnabled</key><true/>
    <key>LSSupportsOpeningDocumentsInPlace</key><true/>
    <key>UILaunchScreen</key><dict/>
    <key>UISupportedInterfaceOrientations</key><array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIApplicationSceneManifest</key><dict>
        <key>UIApplicationSupportsMultipleScenes</key><false/>
        <key>UISceneConfigurations</key><dict>
            <key>UIWindowSceneSessionRoleApplication</key><array><dict>
                <key>UISceneConfigurationName</key><string>Theft4</string>
                <key>UISceneDelegateClassName</key><string>Theft4SceneDelegate</string>
            </dict></array>
        </dict>
    </dict>
</dict></plist>
