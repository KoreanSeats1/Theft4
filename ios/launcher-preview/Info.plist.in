<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>com.theft4.launcher-preview</string>
<key>CFBundleExecutable</key><string>Theft4LauncherPreview</string>
<key>CFBundleName</key><string>Theft4 Menu Preview</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>Theft4LabBuild</key><true/>
<key>Theft4EnhancedBuild</key><true/>
<key>CFBundleVersion</key><string>1</string>
<key>CFBundleShortVersionString</key><string>1.0</string>
<key>UILaunchScreen</key><dict/>
